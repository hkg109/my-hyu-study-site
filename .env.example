# 이 파일은 변수 이름과 설명만 담습니다. 실제 값을 적지 마세요.
# 로컬: 이 파일을 .env.local로 복사해 값을 채웁니다 (.env.local은 Git에서 제외됩니다).
# 배포: Vercel 프로젝트의 Settings → Environment Variables에 같은 이름으로 등록합니다.
# 값을 바꾼 뒤에는 개발 서버를 다시 시작하거나(로컬) 다시 배포해야(Vercel) 반영됩니다.

# 인증 쿠키 서명용 비밀값. 32자 이상의 무작위 문자열을 쓰세요.
# 예) node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 비어 있으면 모든 족보가 잠기고 관리자 모드가 꺼집니다. 바꾸면 모든 족보·관리자 인증이 초기화됩니다.
AUTH_SECRET=

# accessKey가 없는 족보에 쓰는 기본 비밀번호.
PRACTICE_PASSWORD_DEFAULT=

# 족보별 개별 비밀번호: 족보 frontmatter의 `accessKey: cse-midterm`은
# PRACTICE_PASSWORD_CSE_MIDTERM을 읽습니다 (대문자로 바꾸고 '-'를 '_'로).
# 변수가 없으면 그 족보는 기본 비밀번호로 대체되지 않고 잠긴 상태로 남습니다.
PRACTICE_PASSWORD_CSE_MIDTERM=
PRACTICE_PASSWORD_CSE_FINAL=
PRACTICE_PASSWORD_MIS_2025_MIDTERM=
PRACTICE_PASSWORD_CPP_MIDTERM=
PRACTICE_PASSWORD_CPP_2025_FINAL=

# 로컬 개발 서버(npm run dev)의 관리자 모드 비밀번호. 배포 환경에는 등록하지 않아도 됩니다.
ADMIN_PASSWORD=
